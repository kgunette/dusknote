dist/
dev-dist/
.DS_Store
*.local

# Local env. .env.local is what the setup guide tells people to create, but the near-universal
# habit is `cp .env.example .env`, which *.local does not catch. The one value here is a public
# OAuth Client ID, so the risk is a forker who puts something else in the file.
.env
.env.*
!.env.example
